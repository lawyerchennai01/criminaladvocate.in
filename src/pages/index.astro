---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rajendra Criminal Law Firm | Best Criminal Advocates in Chennai">
  <section class="bg-navy text-cream py-24">
    <div class="max-w-6xl mx-auto px-6">
      <h1 class="font-serif text-4xl md:text-6xl leading-tight max-w-3xl">Trusted Criminal Defence in Chennai</h1>
      <p class="mt-6 text-lg text-cream/80 max-w-2xl">Senior advocates with experience in bail, NDPS, cyber crime, and serious criminal trials before the Madras High Court.</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="tel:+919994287060" class="bg-crimson text-white px-8 py-4 rounded-sm">Call +91 99942 87060</a>
        <a href="https://wa.me/919994287060" class="border border-gold text-gold px-8 py-4 rounded-sm">WhatsApp</a>
      </div>
    </div>
  </section>
  <section class="bg-cream py-20">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="font-serif text-3xl text-navy mb-8">Core Practice Areas</h2>
      <div class="grid md:grid-cols-3 gap-6 text-left">
        <div class="bg-white p-6 border border-navy/10"><h3 class="font-serif text-xl text-navy mb-2">Bail & Anticipatory Bail</h3><p class="text-sm text-ink/80">Urgent applications before Magistrate, Sessions and High Court.</p></div>
        <div class="bg-white p-6 border border-navy/10"><h3 class="font-serif text-xl text-navy mb-2">NDPS Cases</h3><p class="text-sm text-ink/80">Defence in narcotic drugs matters with focus on procedural compliance.</p></div>
        <div class="bg-white p-6 border border-navy/10"><h3 class="font-serif text-xl text-navy mb-2">Cyber Crime</h3><p class="text-sm text-ink/80">Online fraud, banking fraud and IT Act cases.</p></div>
      </div>
    </div>
  </section>
</Layout>
