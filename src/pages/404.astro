---
import Layout from '../layouts/Layout.astro';
import { FEATURED, catUrl } from '../data/site';
---
<Layout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <p class="text-crimson text-sm font-semibold uppercase tracking-widest">Error 404</p>
    <h1 class="font-serif text-4xl text-navy font-bold mt-2">We could not find that page</h1>
    <p class="mt-4 text-ink/70">It may have moved. Try one of these sections instead.</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2">
      <li><a href="/" class="px-4 py-2 bg-white border border-navy/15 hover:border-gold rounded-full text-navy text-sm">Home</a></li>
      <li><a href="/legal-services/" class="px-4 py-2 bg-white border border-navy/15 hover:border-gold rounded-full text-navy text-sm">Legal services</a></li>
      <li><a href="/faq/" class="px-4 py-2 bg-white border border-navy/15 hover:border-gold rounded-full text-navy text-sm">FAQ</a></li>
      <li><a href="/contact/" class="px-4 py-2 bg-white border border-navy/15 hover:border-gold rounded-full text-navy text-sm">Contact</a></li>
      {FEATURED.slice(0, 6).map((c) => <li><a href={catUrl(c)} class="px-4 py-2 bg-white border border-navy/15 hover:border-gold rounded-full text-navy text-sm">{c.name}</a></li>)}
    </ul>
  </section>
</Layout>
