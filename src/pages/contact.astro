---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Rajendra Criminal Law Firm">
  <section class="max-w-4xl mx-auto px-6 py-20">
    <p class="text-gold text-sm uppercase tracking-widest mb-4">Contact</p>
    <h1 class="font-serif text-4xl md:text-5xl text-navy mb-8">Speak with a Senior Advocate</h1>
    
    <p class="text-ink/80 text-lg mb-12 max-w-2xl">
      For arrests, bail, or any urgent criminal matter, reach us immediately. Initial consultation available.
    </p>

    <div class="flex flex-wrap gap-4 mb-16">
      <a id="wa-contact" href="#" class="contact-btn contact-btn-whatsapp text-lg">
        WhatsApp +91 99942 87060
      </a>
      <a href="tel:+919994287060" class="contact-btn contact-btn-call text-lg">
        Call +91 99942 87060
      </a>
      <a href="mailto:criminaladvocate.in@gmail.com?subject=Criminal%20Legal%20Inquiry" class="contact-btn contact-btn-email text-lg">
        Email Us
      </a>
    </div>

    <div class="grid md:grid-cols-2 gap-10">
      <div class="bg-white p-8 border border-navy/10">
        <h2 class="font-serif text-xl text-navy mb-4">Office</h2>
        <p class="text-ink/80 leading-relaxed">
          West Mogappair<br />
          Chennai – 600037<br />
          Tamil Nadu, India
        </p>
        <p class="mt-6 text-sm text-ink/60">
          Emergency assistance available 24 hours. Office consultations by appointment.
        </p>
      </div>
      <div class="bg-white p-8 border border-navy/10">
        <h2 class="font-serif text-xl text-navy mb-4">Direct Details</h2>
        <p class="text-ink/80"><strong>Phone / WhatsApp:</strong> +91 99942 87060</p>
        <p class="text-ink/80 mt-2"><strong>Email:</strong> criminaladvocate.in@gmail.com</p>
      </div>
    </div>
  </section>

  <script>
    const wa = document.getElementById('wa-contact');
    if (wa) {
      const msg = encodeURIComponent(
        `Hello Rajendra Criminal Law Firm,\n\n` +
        `I need legal assistance regarding a criminal matter.\n\n` +
        `Page: ${window.location.href}\n` +
        `Please contact me.`
      );
      wa.href = `https://wa.me/919994287060?text=${msg}`;
    }
  </script>
</Layout>
