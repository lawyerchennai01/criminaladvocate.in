---
import Layout from '../layouts/Layout.astro';
import { SITE, waLink, mailLink } from '../data/site';
const canonical = SITE.url + '/contact/';
const schema = [
  { '@type': 'ContactPage', '@id': canonical + '#contactpage', url: canonical, name: 'Contact Rajendra Criminal Law Firm', about: { '@id': SITE.url + '/#legalservice' } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }, { '@type': 'ListItem', position: 2, name: 'Contact' }] },
];
---

<Layout title="Contact Rajendra Criminal Law Firm, Chennai" description="Address, phone, email and consultation hours of Rajendra Criminal Law Firm — Mogappair West and Madras High Court offices, Chennai." canonical={canonical} schema={schema}>
  <section class="bg-navy text-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold">Contact</h1>
      <p class="mt-3 text-cream/80 max-w-2xl">For general information about the firm. Consultations are by appointment. This website is informational and does not solicit work.</p>
    </div>
  </section>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex flex-wrap gap-3 mb-12">
      <a data-wa href={waLink(canonical)} target="_blank" rel="noopener" class="bg-[#25d366] hover:bg-[#1fb957] text-white font-semibold px-6 py-3 rounded-sm">WhatsApp {SITE.phoneDisplay}</a>
      <a href={`tel:${SITE.phoneTel}`} class="bg-crimson hover:bg-[#7e1526] text-white font-semibold px-6 py-3 rounded-sm">Call {SITE.phoneDisplay}</a>
      <a href={mailLink(canonical)} class="bg-navy hover:bg-[#13315a] text-cream font-semibold px-6 py-3 rounded-sm">Email</a>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <section class="bg-white border border-navy/10 p-6">
        <h2 class="font-serif text-xl text-navy font-bold mb-3">Chennai office</h2>
        <address class="not-italic text-ink/80 leading-relaxed">{SITE.address.street},<br />{SITE.address.locality} – {SITE.address.postalCode}<br />{SITE.address.region}, India</address>
        <a href={`https://www.google.com/maps/search/?api=1&query=${SITE.geo.lat},${SITE.geo.lng}`} class="inline-block mt-3 text-sm text-crimson font-semibold hover:underline" target="_blank" rel="noopener">Open in Google Maps →</a>
      </section>
      <section class="bg-white border border-navy/10 p-6">
        <h2 class="font-serif text-xl text-navy font-bold mb-3">Madras High Court office</h2>
        <address class="not-italic text-ink/80 leading-relaxed">{SITE.highCourtOffice}</address>
      </section>
      <section class="bg-white border border-navy/10 p-6">
        <h2 class="font-serif text-xl text-navy font-bold mb-3">Consultation hours</h2>
        <ul class="text-ink/80 space-y-1">{SITE.hours.map((h) => <li>{h}</li>)}</ul>
      </section>
      <section class="bg-white border border-navy/10 p-6">
        <h2 class="font-serif text-xl text-navy font-bold mb-3">Direct details</h2>
        <p class="text-ink/80"><strong>Phone / WhatsApp:</strong> <a class="text-crimson" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a></p>
        <p class="text-ink/80 mt-2"><strong>Email:</strong> <a class="text-crimson break-all" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </section>
    </div>
    <p class="mt-10 text-sm text-ink/60">Please do not send confidential case details through this website. Contacting the firm does not create an advocate–client relationship until the firm confirms in writing.</p>
  </div>
</Layout>
