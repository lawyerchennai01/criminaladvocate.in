---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Practice Areas | Rajendra Criminal Law Firm">
  <section class="max-w-5xl mx-auto px-6 py-20">
    <p class="text-gold text-sm uppercase tracking-widest mb-4">Services</p>
    <div class="mb-12">
      <img src="/gavel.webp" alt="Scales of justice" class="w-full max-w-md mx-auto rounded-sm" />
    </div>
    <h1 class="font-serif text-4xl md:text-5xl text-navy mb-12">Criminal Practice Areas</h1>

    <div class="space-y-12">
      <div class="border-b border-navy/10 pb-10">
        <h2 class="font-serif text-2xl text-navy mb-3"><a href="/practice/bail" class="hover:text-crimson">Bail & Anticipatory Bail</a></h2>
        <p class="text-ink/80 leading-relaxed">Immediate representation for regular bail, anticipatory bail, and interim bail applications.</p>
      </div>
      <div class="border-b border-navy/10 pb-10">
        <h2 class="font-serif text-2xl text-navy mb-3"><a href="/practice/ndps" class="hover:text-crimson">NDPS Act Cases</a></h2>
        <p class="text-ink/80 leading-relaxed">Defence focused on search, seizure, and procedural compliance.</p>
      </div>
      <div class="border-b border-navy/10 pb-10">
        <h2 class="font-serif text-2xl text-navy mb-3"><a href="/practice/cyber-crime" class="hover:text-crimson">Cyber Crime & IT Act</a></h2>
        <p class="text-ink/80 leading-relaxed">Online fraud, banking fraud, and digital evidence matters.</p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-navy mb-3"><a href="/practice/financial-fraud" class="hover:text-crimson">Financial Fraud & Cheating</a></h2>
        <p class="text-ink/80 leading-relaxed">Cheating, forgery, and white-collar offences.</p>
      </div>
    </div>
  </section>
</Layout>
