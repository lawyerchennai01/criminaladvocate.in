---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Practice Areas | Rajendra Criminal Law Firm">
  <section class="max-w-4xl mx-auto px-6 py-20">
    <h1 class="font-serif text-4xl text-navy mb-8">Practice Areas</h1>
    <div class="space-y-6">
      <div><h2 class="font-serif text-2xl text-navy">Bail & Anticipatory Bail</h2><p class="text-ink/80 mt-2">Urgent applications before all courts in Chennai.</p></div>
      <div><h2 class="font-serif text-2xl text-navy">NDPS Cases</h2><p class="text-ink/80 mt-2">Defence focused on search, seizure and procedural compliance.</p></div>
      <div><h2 class="font-serif text-2xl text-navy">Cyber Crime</h2><p class="text-ink/80 mt-2">Online fraud, banking fraud and IT Act matters.</p></div>
      <div><h2 class="font-serif text-2xl text-navy">Financial Fraud</h2><p class="text-ink/80 mt-2">Cheating, forgery and white-collar offences.</p></div>
    </div>
  </section>
</Layout>
